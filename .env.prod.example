# Cấu hình bản public (chép thành .env trên server). Xem docker-compose.prod.yml.
DOMAIN=studyrag.example.com
PUBLIC_APP_URL=https://studyrag.example.com
CORS_ORIGINS=https://studyrag.example.com

APP_ENV=prod
LOG_FORMAT=json
# Sinh: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
POSTGRES_USER=studyrag
POSTGRES_PASSWORD=
POSTGRES_DB=studyrag

# LLM: gọi thẳng hãng làm chính, ShopAIKey làm dự phòng khi lỗi 403/429.
CHEAP_MODEL_PROVIDER=google
CHEAP_MODEL_NAME=gemini-2.5-flash
STRONG_MODEL_PROVIDER=google
STRONG_MODEL_NAME=gemini-2.5-flash
GOOGLE_API_KEY=
FALLBACK_MODEL_PROVIDER=shopaikey_google
FALLBACK_MODEL_NAME=gemini-2.5-flash
SHOPAIKEY_API_KEY=
# Trống = ẩn bộ chọn model trên UI, không ai gọi được model đắt.
LLM_CHAT_MODELS=

# Bảo vệ chi phí và CPU
ALLOW_DEMO_LOGIN=true
DEMO_ALLOW_UPLOAD=false
QUOTA_DEMO_CHAT_PER_DAY=20
QUOTA_CHAT_PER_DAY=50
QUOTA_GLOBAL_CHAT_PER_DAY=300
QUOTA_UPLOADS_PER_DAY=5
QUOTA_DOCUMENTS_PER_USER=10
RATE_LIMIT_CHAT_PER_MINUTE=10
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=200
MAX_OCR_PAGES=20
OCR_SLIDE_IMAGES=false

# RAG trên CPU yếu: số liệu ở eval/FOLLOWUP.md
RETRIEVAL_MODE=dense
RERANK_ENABLED=true
RERANK_CANDIDATES=10
# Đo trên 81 câu (retrieval-v5-int8-384): p50 13.0s -> 8.4s, MRR 0.854 -> 0.846, hit@5 không đổi
RERANKER_INT8=true
RERANKER_MAX_LENGTH=384
# Đặt bằng số vCPU của server: để 0 thì app tự lấy một nửa, máy 2 vCPU chỉ còn 1 luồng.
RERANKER_THREADS=2
ENABLE_CRAG=false
ENABLE_ANSWER_CRITIC=false
PRELOAD_MODELS=true

# Đăng nhập: có ít nhất một cách ngoài tài khoản dùng thử
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Tuỳ chọn: trace từng lượt chạy
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=studyrag
