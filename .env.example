# --- Postgres ---
POSTGRES_USER=studyrag
POSTGRES_PASSWORD=rag@study
POSTGRES_DB=studyrag
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- LLM providers (model routing theo task, xem app/llm/router.py) ---
# Mặc định thử nghiệm dùng Gemini:
CHEAP_MODEL_PROVIDER=google        # hoặc "openai"
CHEAP_MODEL_NAME=gemini-2.0-flash  # hoặc "gpt-4o-mini"
STRONG_MODEL_PROVIDER=google       # hoặc "anthropic"
STRONG_MODEL_NAME=gemini-2.5-pro   # hoặc "claude-sonnet-4-6", "gemini-1.5-pro"

# API Keys (Điền key tương ứng với provider bạn chọn)
GOOGLE_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Google OAuth 2.0 Credentials
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- App ---
APP_ENV=dev
LOG_LEVEL=INFO
MAX_REFLECTION_LOOPS=2
