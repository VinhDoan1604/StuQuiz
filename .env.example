# ============================================================================
# StudyRAG backend — sao chép thành .env rồi điền giá trị.
# Mọi biến được đọc ở app/config.py (tên biến = tên field viết hoa).
# ============================================================================

# --- App ---
APP_ENV=dev                 # dev | staging | prod  (khác dev: bắt buộc JWT_SECRET mạnh, tắt Swagger/demo)
LOG_LEVEL=INFO
LOG_FORMAT=text             # text | json
PUBLIC_APP_URL=http://localhost:5173

# --- Security ---
# Sinh: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# ALLOW_DEMO_LOGIN=true     # mặc định: chỉ bật khi APP_ENV=dev
MAX_UPLOAD_MB=50
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_CHAT_PER_MINUTE=30
# Bộ đếm rate limit dùng chung giữa nhiều instance (docker-compose tự đặt redis://redis:6379/0)
REDIS_URL=

# --- Postgres ---
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/db   # nếu đặt sẽ ghi đè các biến dưới
POSTGRES_USER=studyrag
POSTGRES_PASSWORD=change-me
POSTGRES_DB=studyrag
POSTGRES_HOST=localhost
POSTGRES_PORT=5433          # cổng host của postgres trong docker-compose

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- LLM providers (model routing theo task, xem app/llm/router.py) ---
# Provider hỗ trợ (khai báo ở app/llm/providers.py):
#   shopaikey_google | shopaikey_openai | shopaikey_anthropic   (qua ShopAIKey, dùng SHOPAIKEY_API_KEY)
#   google | openai | anthropic                                  (gọi thẳng hãng, dùng key riêng)
CHEAP_MODEL_PROVIDER=shopaikey_google
CHEAP_MODEL_NAME=gemini-2.5-flash
STRONG_MODEL_PROVIDER=shopaikey_google
STRONG_MODEL_NAME=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# Model user chọn trên khung chat: "<provider>:<model>|Nhãn", phân tách bằng dấu phẩy.
# Để trống = ẩn bộ chọn, luôn dùng model mặc định ở trên.
LLM_CHAT_MODELS=shopaikey_google:gemini-2.5-flash|Gemini 2.5 Flash,shopaikey_google:gemini-2.5-pro|Gemini 2.5 Pro,shopaikey_openai:gpt-5-mini|GPT-5 mini,shopaikey_anthropic:claude-sonnet-4-20250514|Claude Sonnet 4

# Judge cho eval/ (eval/judge.py) — nên KHÁC họ model sinh. Thử ứng viên: python -m eval.probe_judges
# Chọn qua probe_judges (03/11/2026): gpt-5.4 20/20 lời gọi OK, p50 3.5s; claude-sonnet-4-6 0/20
# (ValidationError structured output qua proxy); gpt-5-mini 20/20 nhưng chậm gấp ~3 và từng lỗi 403.
EVAL_JUDGE_PROVIDER=shopaikey_openai
EVAL_JUDGE_MODEL=gpt-5.4

# ShopAIKey (https://shopaikey.com/docs) — 1 key cho cả 3 định dạng
SHOPAIKEY_API_KEY=
# SHOPAIKEY_BASE_URL=https://api.shopaikey.com             # Anthropic & Google GenAI (mặc định)
# SHOPAIKEY_OPENAI_BASE_URL=https://api.shopaikey.com/v1   # OpenAI (mặc định)

# Key gọi thẳng hãng (chỉ cần khi dùng provider google/openai/anthropic; GEMINI_API_KEY = tên thay thế GOOGLE_API_KEY)
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Tracing (tuỳ chọn) — LangChain/LangGraph tự gửi trace mỗi lần chạy graph lên LangSmith ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=studyrag

# --- Google OAuth 2.0 (để trống = tắt đăng nhập Google; frontend tự lấy client id từ backend) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- SMTP gửi OTP (bắt buộc khi APP_ENV != dev; dev không cấu hình thì mã OTP hiện ngay trên UI) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- RAG ---
# Số liệu đằng sau các mặc định: eval/results/full-v1/report.md, EVAL_FOLLOWUP.md
RETRIEVAL_MODE=dense        # dense | hybrid (sparse không giúp gì khi đã rerank — retrieval-v3)
RERANK_ENABLED=true         # reranker: cải thiện duy nhất có ý nghĩa thống kê (MRR +0.17)
RERANK_CANDIDATES=10        # số ứng viên đưa vào reranker; latency CPU ~ tuyến tính theo số này
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_MAX_LENGTH=512
RERANKER_INT8=false         # true: lượng tử hoá int8 trên CPU (nhanh hơn, đo lại retrieval trước khi bật)
RERANKER_DEVICE=            # trống = tự chọn; hoặc cpu / cuda:0
RERANKER_THREADS=0          # 0 = os.cpu_count()//2; luồng phụ của torch mặc định chỉ dùng nửa số này
ENABLE_CRAG=false           # chấm context + viết lại truy vấn (tốn ~2x token; xem EVAL_FOLLOWUP.md)
ENABLE_ANSWER_CRITIC=false  # chấm faithfulness theo từng khẳng định + sinh lại
# Model riêng cho critic, nên KHÁC họ với model sinh (trống = CHEAP model)
CRITIC_MODEL_PROVIDER=
CRITIC_MODEL_NAME=
MAX_REFLECTION_LOOPS=2
ENABLE_PARENT_EXPANSION=true
PARENT_CONTEXT_MAX_TOKENS=3500
PRELOAD_MODELS=false        # true: tải BGE-M3 + reranker lúc khởi động (nên bật ở production)

# --- Ingestion ---
OCR_LANG=vie+eng            # ngôn ngữ Tesseract cho PDF scan + chữ trong hình slide
OCR_SLIDE_IMAGES=true       # OCR chữ trong hình của PPTX (sơ đồ, bảng chụp); false = upload nhanh hơn
